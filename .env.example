# Local database-backed login, or use SPRING_PROFILES_ACTIVE=oidc for external JWT API clients.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/nyt_loans
DATABASE_USER=
DATABASE_PASSWORD=
PORT=8080
DEBUG=false

# Generate random independent 32-byte base64 keys. Keep them when restarting.
ENCRYPTION_ACTIVE_KEY_ID=primary
ENCRYPTION_KEYS=
AUTH_LOOKUP_KEY=
AUTH_SESSION_DURATION=PT8H
AUTH_MAX_FAILURES=5
AUTH_LOCK_DURATION=PT15M

# Optional first administrator. Existing accounts are never reset on restart.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

DOCUMENT_MAX_BYTES=5242880
MAX_UPLOAD_SIZE=5MB
MAX_REQUEST_SIZE=6MB
API_DOCS_ENABLED=false

# Required only for the oidc profile.
OIDC_ISSUER_URI=
OIDC_JWK_SET_URI=
OIDC_AUDIENCE=loan-api
OIDC_ROLES_CLAIM=roles

