{
  "name": "nyt-loan-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "pg": "8.23.0",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "transform": {},
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "statements": 85
      }
    }
  }
}
